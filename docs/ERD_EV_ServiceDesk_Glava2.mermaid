erDiagram
%% EV-ServiceDesk — ER-диаграмма (Глава 2)
%% СГЕНЕРИРОВАНО из backend/app/models: cd backend && poetry run python scripts/export_erd.py
%% Не редактировать вручную. ||--o{ — обязательный FK, |o--o{ — необязательный.
    aggregate_type {
        bigint id PK
        varchar_50 code UK
        varchar_100 name
        timestamptz created_at
        timestamptz updated_at
    }
    app_user {
        bigint id PK
        varchar_16 phone UK "nullable"
        user_role role
        varchar_50 telegram_id UK "nullable"
        varchar_255 password_hash "nullable"
        boolean is_active
        timestamptz anonymized_at "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    decision_tree_node {
        bigint id PK
        bigint article_id FK "unique (article_id) where is_root = true"
        text question_text
        jsonb options
        boolean is_root
        boolean is_escalation
        timestamptz created_at
        timestamptz updated_at
    }
    firmware_release {
        bigint id PK
        bigint vehicle_model_id FK
        varchar_50 version
        date released_at
        timestamptz created_at
    }
    knowledge_article {
        bigint id PK
        bigint vehicle_model_id FK "nullable"
        bigint firmware_release_id FK "nullable"
        kb_article_type article_type
        varchar_200 title
        text content
        integer version
        boolean is_published
        timestamptz created_at
        timestamptz updated_at
    }
    maintenance_record {
        bigint id PK
        bigint vehicle_id FK
        bigint aggregate_type_id FK "nullable"
        bigint performed_by_user_id FK "nullable"
        bigint ticket_id FK "nullable"
        date performed_at
        integer mileage_at_service
        varchar_255 description "nullable"
        timestamptz created_at
    }
    maintenance_regulation {
        bigint id PK
        bigint vehicle_model_id FK "unique (vehicle_model_id, aggregate_type_id) where is_archived = false"
        bigint aggregate_type_id FK
        integer interval_km "nullable"
        integer interval_months "nullable"
        boolean is_archived
        timestamptz created_at
        timestamptz updated_at
    }
    notification {
        bigint id PK
        notification_type type
        bigint firmware_release_id FK "nullable"
        bigint target_vehicle_model_id FK "nullable"
        text message
        timestamptz created_at
    }
    notification_delivery {
        bigint id PK
        bigint notification_id FK
        bigint push_token_id FK
        timestamptz delivered_at "nullable"
        timestamptz opened_at "nullable"
        timestamptz created_at
    }
    notification_recipient {
        bigint id PK
        bigint notification_id FK
        bigint user_id FK
        timestamptz read_at "nullable"
        timestamptz created_at
    }
    pd_consent {
        bigint id PK
        bigint user_id FK "unique (user_id) where withdrawn_at IS NULL"
        varchar_20 policy_version
        timestamptz given_at
        timestamptz withdrawn_at "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    push_token {
        bigint id PK
        bigint user_id FK
        varchar_255 token UK
        timestamptz created_at
        timestamptz updated_at
    }
    refresh_token {
        bigint id PK
        bigint user_id FK
        varchar_64 token_hash UK
        timestamptz expires_at
        timestamptz revoked_at "nullable"
        timestamptz created_at
    }
    ticket {
        bigint id PK
        bigint vehicle_id FK
        ticket_category category
        ticket_status status
        text description
        bigint assigned_engineer_id FK "nullable"
        timestamptz sla_due_at
        bigint firmware_release_id FK "nullable"
        bigint source_article_id FK "nullable"
        bigint source_node_id FK "nullable"
        timestamptz first_response_at "nullable"
        timestamptz resolved_at "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    ticket_attachment {
        bigint id PK
        bigint ticket_id FK
        bigint ticket_message_id FK "nullable"
        varchar_500 object_key UK
        attachment_type file_type
        varchar_100 mime_type
        bigint size_bytes
        bigint uploaded_by_user_id FK
        timestamptz created_at
    }
    ticket_message {
        bigint id PK
        bigint ticket_id FK
        bigint author_id FK
        text body
        timestamptz created_at
    }
    vehicle {
        bigint id PK
        bigint user_id FK
        bigint vehicle_model_id FK
        char_17 vin "unique (vin) where deleted_at IS NULL"
        integer mileage
        bigint current_firmware_release_id FK "nullable"
        timestamptz deleted_at "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    vehicle_aggregate_status {
        bigint id PK
        bigint vehicle_id FK
        bigint aggregate_type_id FK
        date last_replaced_at "nullable"
        integer last_replaced_mileage "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    vehicle_mileage_correction {
        bigint id PK
        bigint vehicle_id FK
        bigint corrected_by_user_id FK
        integer old_mileage
        integer new_mileage
        varchar_500 reason
        timestamptz created_at
    }
    vehicle_model {
        bigint id PK
        varchar_100 brand
        varchar_100 model
        varchar_100 trim
        timestamptz created_at
        timestamptz updated_at
    }

    knowledge_article ||--o{ decision_tree_node : "article_id (CASCADE)"
    vehicle_model ||--o{ firmware_release : "vehicle_model_id (RESTRICT)"
    firmware_release |o--o{ knowledge_article : "firmware_release_id, vehicle_model_id (RESTRICT)"
    vehicle_model |o--o{ knowledge_article : "vehicle_model_id (RESTRICT)"
    aggregate_type |o--o{ maintenance_record : "aggregate_type_id (RESTRICT)"
    app_user |o--o{ maintenance_record : "performed_by_user_id (RESTRICT)"
    ticket |o--o{ maintenance_record : "ticket_id (SET NULL)"
    vehicle ||--o{ maintenance_record : "vehicle_id (RESTRICT)"
    aggregate_type ||--o{ maintenance_regulation : "aggregate_type_id (RESTRICT)"
    vehicle_model ||--o{ maintenance_regulation : "vehicle_model_id (RESTRICT)"
    firmware_release |o--o{ notification : "firmware_release_id, target_vehicle_model_id (RESTRICT)"
    vehicle_model |o--o{ notification : "target_vehicle_model_id (RESTRICT)"
    notification ||--o{ notification_delivery : "notification_id (CASCADE)"
    push_token ||--o{ notification_delivery : "push_token_id (CASCADE)"
    notification ||--o{ notification_recipient : "notification_id (CASCADE)"
    app_user ||--o{ notification_recipient : "user_id (CASCADE)"
    app_user ||--o{ pd_consent : "user_id (RESTRICT)"
    app_user ||--o{ push_token : "user_id (CASCADE)"
    app_user ||--o{ refresh_token : "user_id (CASCADE)"
    app_user |o--o{ ticket : "assigned_engineer_id (RESTRICT)"
    firmware_release |o--o{ ticket : "firmware_release_id (RESTRICT)"
    knowledge_article |o--o{ ticket : "source_article_id (SET NULL)"
    decision_tree_node |o--o{ ticket : "source_node_id (SET NULL)"
    vehicle ||--o{ ticket : "vehicle_id (RESTRICT)"
    ticket_message |o--o{ ticket_attachment : "ticket_message_id, ticket_id (RESTRICT)"
    ticket ||--o{ ticket_attachment : "ticket_id (RESTRICT)"
    app_user ||--o{ ticket_attachment : "uploaded_by_user_id (RESTRICT)"
    app_user ||--o{ ticket_message : "author_id (RESTRICT)"
    ticket ||--o{ ticket_message : "ticket_id (RESTRICT)"
    firmware_release |o--o{ vehicle : "current_firmware_release_id, vehicle_model_id (RESTRICT)"
    app_user ||--o{ vehicle : "user_id (RESTRICT)"
    vehicle_model ||--o{ vehicle : "vehicle_model_id (RESTRICT)"
    aggregate_type ||--o{ vehicle_aggregate_status : "aggregate_type_id (RESTRICT)"
    vehicle ||--o{ vehicle_aggregate_status : "vehicle_id (CASCADE)"
    app_user ||--o{ vehicle_mileage_correction : "corrected_by_user_id (RESTRICT)"
    vehicle ||--o{ vehicle_mileage_correction : "vehicle_id (RESTRICT)"
