{
  "name": "ev-servicedesk",
  "private": true,
  "workspaces": [
    "web-engineer",
    "web-admin",
    "web-shared"
  ],
  "scripts": {
    "lint:api": "spectral lint docs/openapi.yaml --fail-severity=warn",
    "gen:api": "openapi-typescript docs/openapi.yaml -o web-shared/src/api/schema.ts",
    "mock": "prism mock docs/openapi.yaml --port 4010 --host 127.0.0.1 --errors",
    "test:mock": "node scripts/mock_smoke.mts",
    "tokens": "node scripts/design_tokens.mts",
    "test:tokens": "node --test scripts/design_tokens.test.mts",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@stoplight/spectral-cli": "6.16.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.3"
  }
}
