#!/bin/sh
# Pre-commit: поиск секретов в staged-изменениях (Issue #15, AGENTS.md → Безопасность).
# Подключение: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks не установлен (brew install gitleaks) — коммит остановлен." >&2
    exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner -v
