{
 "uid": "ev-overview",
 "title": "EV-ServiceDesk — обзор",
 "schemaVersion": 41,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "ev-servicedesk"
 ],
 "panels": [
  {
   "id": 1,
   "title": "Доступность за 30 дней (цель 99,5 %)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg_over_time(probe_success{job=\"probe_self\"}[30d])",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 0.995
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   }
  },
  {
   "id": 2,
   "title": "Запросы в секунду",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 9,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (status) (rate(ev_http_requests_total{route!~\"/health|/metrics\"}[5m]))",
     "legendFormat": "{{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Доля 5xx (critical > 5 %)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 9,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ev:http_errors:rate5m / ev:http_requests:rate5m",
     "legendFormat": "5xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Проба /health снаружи",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{job=~\"probe_self|probe_peer\"}",
     "legendFormat": "{{probe}} {{instance}}"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "НЕТ",
         "color": "red"
        },
        "1": {
         "text": "OK",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "p95 по маршрутам (норматив чтения 300 мс)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(ev_http_request_duration_seconds_bucket{route!~\"/health|/metrics\"}[5m]))))",
     "legendFormat": "{{route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "title": "Worker'ы: с последнего успешного цикла",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - ev_worker_last_success_timestamp_seconds",
     "legendFormat": "{{worker}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Очереди: push и анонимизация",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ev_push_queue_pending",
     "legendFormat": "push — ждут"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ev_push_queue_oldest_age_seconds",
     "legendFormat": "push — возраст, с"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ev_privacy_queue_size",
     "legendFormat": "анонимизация — клиентов"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "ev_privacy_queue_oldest_age_seconds / 86400",
     "legendFormat": "анонимизация — дней"
    }
   ]
  },
  {
   "id": 8,
   "title": "Бэкапы: с последнего успешного",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - ev_backup_last_success_timestamp_seconds",
     "legendFormat": "{{type}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "pg_stat_archiver_last_archive_age",
     "legendFormat": "WAL"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "PostgreSQL: соединения и размер БД",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(pg_stat_activity_count)",
     "legendFormat": "соединения"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "pg_settings_max_connections",
     "legendFormat": "max_connections"
    }
   ]
  },
  {
   "id": 10,
   "title": "Ресурсы ВМ",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
     "legendFormat": "память"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
     "legendFormat": "диск"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
     "legendFormat": "CPU"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "title": "Память контейнеров",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (container_memory_working_set_bytes{service!=\"\"})",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "title": "Ошибки в журнале (level=ERROR)",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{level=\"ERROR\"}"
    }
   ]
  },
  {
   "id": 13,
   "title": "События безопасности",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{logger=\"app.security\"}"
    }
   ]
  }
 ]
}
