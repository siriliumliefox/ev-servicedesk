# Окружение staging (глава 26, ADR 0030): переменные, не секреты. Секреты — каталог secrets/
# (deploy.sh из bundle), значения, зависящие от аккаунта (имена бакетов, chat_id) — overrides.env
# из переменных окружения GitHub `staging`.
EV_ENV=staging
EV_APP_ENVIRONMENT=staging
COMPOSE_PROFILES=letsencrypt
EV_API_HOST=api.staging.etsautogomel.by
EV_ENGINEER_HOST=engineer.staging.etsautogomel.by
EV_ADMIN_HOST=admin.staging.etsautogomel.by
EV_SELF_HEALTH_URL=https://api.staging.etsautogomel.by/health
EV_PEER_HEALTH_URL=https://api.etsautogomel.by/health
EV_PEER_ENV=production

# S3 Timeweb (Санкт-Петербург, ru-1); бакеты — overrides.env.
EV_S3_ENDPOINT=https://s3.twcstorage.ru
EV_S3_PUBLIC_ENDPOINT=
EV_MEDIA_ORIGIN=https://s3.twcstorage.ru
EV_BACKUP_S3_ENDPOINT=s3.twcstorage.ru
EV_S3_REGION=ru-1
EV_S3_MEDIA_BUCKET=ev-staging-media
EV_S3_BACKUP_BUCKET=ev-staging-backup

EV_SMS_PROVIDER=a1
EV_PUSH_PROVIDER=fake

EV_APP_SUBNET=172.30.10.0/24
EV_APP_IP_RANGE=172.30.10.128/25
EV_NGINX_IP=172.30.10.10
EV_TEXTFILE_DIR=/var/lib/ev/staging/textfile
EV_LOG_RETENTION=168h
EV_METRICS_RETENTION=15d

# Алерты: chat_id Telegram — overrides.env (EV_TELEGRAM_CHAT_ID); пусто — без Telegram.
EV_TELEGRAM_CHAT_ID=
EV_ALERT_WEBHOOK_URL=
EV_PROBE_CA_FILE=
