# EV-ServiceDesk — шаблон переменных окружения (Глава 4, шаг 3)
#
# Скопируйте в .env для локальной разработки: cp .env.example .env
# Значения ниже — local-safe заглушки, менять для local не обязательно.
#
# Для staging/production этот файл НЕ используется напрямую — реальные
# значения живут в GitHub Environment Secrets (см. docs/ENVIRONMENTS.md) и
# попадают в среду исполнения через CD-пайплайн (Глава 4, шаг 5), а не
# через закоммиченный файл. .env* (кроме .example) — в .gitignore, это
# гарантия, а не пожелание.

# --- Общее ---
# local | test | staging | production (иное — ошибка старта; образ по умолчанию — production)
ENVIRONMENT=local

# --- База данных ---
POSTGRES_USER=ev
POSTGRES_PASSWORD=ev_local_only
POSTGRES_DB=ev_servicedesk
DATABASE_URL=postgresql+psycopg://ev:ev_local_only@localhost:5432/ev_servicedesk

# --- Redis (TTL SMS-кодов, Глава 10) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (Глава 10, ADR 0005/0013) ---
# Локально — любые значения. На staging/production — уникальные случайные
# секреты (≥ 32 символов) на каждое окружение, генерировать: scripts/generate-secret.sh.
# С заглушками приложение вне local/test не стартует.
JWT_SECRET=change-me-in-every-real-environment
# Ключ HMAC для SMS-кодов в Redis (сам код нигде не хранится)
SMS_CODE_SECRET=change-me-sms-code-secret
# Необязательные (значения по умолчанию в app/core/config.py):
# ACCESS_TOKEN_TTL_SECONDS=900  REFRESH_TOKEN_TTL_DAYS=30
# SMS_CODE_LENGTH=4  SMS_CODE_TTL_SECONDS=120  SMS_CODE_MAX_ATTEMPTS=5

# --- SMS-провайдер (Глава 10) ---
# fake — local/test: код не отправляется и не логируется; при ENVIRONMENT=local
# доступен через GET /v1/_debug/sms/last-code?phone=... (вне local маршрута нет).
# a1 — A1 «Smart-рассылка» (smart-sender.a1.by): логин (msisdn) + API-ключ из
# личного кабинета; A1 должен разрешить IP сервера. В production fake запрещён.
SMS_PROVIDER=fake
SMS_PROVIDER_USER=
SMS_PROVIDER_API_KEY=
# Альфа-имя отправителя (≤ 11 символов, одобряется в кабинете A1, напр. ETSGOMEL);
# пусто — имя по умолчанию. Проверка ключа/IP/имени: python3 scripts/a1_check.py
SMS_SENDER=

# --- S3-совместимое хранилище (Глава 13, ADR 0004/0017: вложения, presigned URL) ---
# Локально — MinIO из docker compose (бакет и правило «uploads/ старше суток удаляются»
# создаёт сервис minio-init); ключи ниже — root-учётка этого MinIO, только для local.
# Вне local/test с пустыми ключами или этими заглушками, а также без доступного бакета
# backend не стартует. Провайдер staging/production — Глава 26.
S3_ENDPOINT=http://localhost:9000
# Адрес S3 для клиентов (presigned URL подписываются вместе с хостом); пусто = S3_ENDPOINT.
# Телефон в локальной сети: http://<IP Mac>:9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ev-servicedesk-local
S3_ACCESS_KEY=ev_local
S3_SECRET_KEY=ev_local_only
# Необязательные (значения по умолчанию в app/core/config.py, ADR 0017):
# TICKET_CREATE_PER_USER_HOUR=10  TICKET_MESSAGE_PER_USER_MINUTE=30
# UPLOAD_PRESIGN_PER_USER_HOUR=60  PRESIGN_PUT_TTL_SECONDS=900  PRESIGN_GET_TTL_SECONDS=900
# MAX_ATTACHMENTS=10  ATTACHMENT_PHOTO_MAX_BYTES=20971520  ATTACHMENT_VIDEO_MAX_BYTES=209715200
# WS_AUTH_TIMEOUT_SECONDS=5  WS_MAX_SOCKETS_PER_USER=10  WS_CONNECTS_PER_IP_MINUTE=60
# WS_EVENT_QUEUE_SIZE=100  REDIS_PUBSUB_PING_SECONDS=10
# Префикс каналов Redis pub/sub (события тикетов): пусто = ev-servicedesk:<ENVIRONMENT>.
# Номер БД Redis каналы не разделяет — стенды на одном сервере Redis должны различаться префиксом.
# REDIS_CHANNEL_PREFIX=

# --- Push и worker уведомлений (Глава 15, ADR 0019) ---
# fake — без Firebase (local/test/staging, push только в журнал); fcm — FCM HTTP v1.
# В production fake запрещён. Для iOS в консоли Firebase привязан APNs-ключ (.p8) —
# нужен платный Apple Developer (mobile/README.md, docs/NOTIFICATIONS_E2E.md).
PUSH_PROVIDER=fake
# Содержимое JSON-ключа сервисного аккаунта Firebase одной строкой (не путь к файлу).
# Вводит владелец: scripts/set-fcm-secret.sh; в git и в чат не попадает.
FCM_SERVICE_ACCOUNT_JSON=
# Необязательные: NOTIFICATIONS_POLL_SECONDS=5  NOTIFICATIONS_BATCH_SIZE=100
# PUSH_MAX_ATTEMPTS=5  PUSH_RETRY_BASE_SECONDS=10  FCM_TIMEOUT_SECONDS=10
# MAINTENANCE_REMINDER_HOUR=10   # час запуска напоминаний о ТО по Europe/Minsk
