{
  "$description": "EV-ServiceDesk — дизайн-токены (Глава 6, Issue #34, ADR 0010). Единственный источник истины: из этого файла генерируются web-shared/src/theme/tokens.css и mobile/lib/theme/tokens.g.dart (`npm run tokens`), по нему же собраны Variables в Figma. Формат — W3C Design Tokens (DTCG): $value / $type, ссылки {group.token}.",

  "color": {
    "$type": "color",
    "$description": "Примитивы. В интерфейсе напрямую не используются — только через семантические токены theme.*.",
    "brand": {
      "$description": "ETS AUTO (головной филиал, https://ets-auto.by): --primary #f9ce12, текст #171717, логотип — жёлтый на чёрном.",
      "yellow": { "$value": "#f9ce12" },
      "yellow-hover": { "$value": "#e6bc00" },
      "yellow-light": { "$value": "#ffd83d" },
      "yellow-text": { "$value": "#7a5c00", "$description": "Тёмный оттенок бренда для текста и ссылок на светлом фоне: #f9ce12 на белом — 1.5:1." },
      "ink": { "$value": "#171717" },
      "blue": { "$value": "#004f91", "$description": "Информационный синий с сайта ETS AUTO." }
    },
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#fafafa" },
      "100": { "$value": "#f4f4f5" },
      "200": { "$value": "#e4e4e7" },
      "300": { "$value": "#d4d4d8" },
      "400": { "$value": "#a1a1aa" },
      "500": { "$value": "#71717a" },
      "600": { "$value": "#52525b" },
      "700": { "$value": "#3f3f46" },
      "800": { "$value": "#27272a" },
      "900": { "$value": "#18181b" },
      "950": { "$value": "#0f0f10" }
    },
    "green": {
      "100": { "$value": "#dcfce7" },
      "300": { "$value": "#86efac" },
      "500": { "$value": "#22c55e" },
      "600": { "$value": "#16a34a" },
      "700": { "$value": "#15803d" },
      "800": { "$value": "#166534" },
      "950": { "$value": "#052e16" }
    },
    "amber": {
      "$description": "Статус «скоро менять». Янтарный, а не брендовый жёлтый: оттенок сдвинут, статус всегда с иконкой-треугольником и подписью.",
      "100": { "$value": "#fef3c7" },
      "300": { "$value": "#fcd34d" },
      "500": { "$value": "#f59e0b" },
      "600": { "$value": "#d97706" },
      "700": { "$value": "#b86e00" },
      "800": { "$value": "#92400e" },
      "950": { "$value": "#451a03" }
    },
    "red": {
      "100": { "$value": "#fee2e2" },
      "300": { "$value": "#fca5a5" },
      "400": { "$value": "#f87171" },
      "500": { "$value": "#ef4444" },
      "600": { "$value": "#dc2626" },
      "700": { "$value": "#b91c1c" },
      "800": { "$value": "#991b1b" },
      "950": { "$value": "#450a0a" }
    },
    "blue": {
      "400": { "$value": "#60a5fa" }
    }
  },

  "theme": {
    "$type": "color",
    "$description": "Семантические токены. light — клиент (mobile-first) и админ-панель; dark — веб-кабинет инженера (ночные смены, ТЗ раздел 6). Набор ключей в темах одинаковый (проверяется тестом).",
    "light": {
      "canvas": { "$value": "{color.neutral.50}", "$description": "Фон страницы" },
      "surface": { "$value": "{color.neutral.0}", "$description": "Карточки, поля, панели" },
      "surface-subtle": { "$value": "{color.neutral.100}", "$description": "Вторичные блоки, ховер строк" },
      "fg": { "$value": "{color.brand.ink}", "$description": "Основной текст" },
      "fg-muted": { "$value": "{color.neutral.600}", "$description": "Вторичный текст, подписи" },
      "fg-disabled": { "$value": "{color.neutral.400}", "$description": "Неактивный текст (WCAG 1.4.3 не требует контраста)" },
      "border": { "$value": "{color.neutral.200}", "$description": "Декоративные разделители" },
      "border-strong": { "$value": "{color.neutral.500}", "$description": "Границы полей ввода, ≥ 3:1" },
      "primary": { "$value": "{color.brand.yellow}", "$description": "Заливка основной кнопки, активный пункт навигации" },
      "primary-hover": { "$value": "{color.brand.yellow-hover}" },
      "on-primary": { "$value": "{color.brand.ink}", "$description": "Текст и иконки на primary" },
      "primary-text": { "$value": "{color.brand.yellow-text}", "$description": "Ссылки и акцентный текст" },
      "focus-ring": { "$value": "{color.brand.ink}" },
      "danger": { "$value": "{color.red.700}" },
      "danger-hover": { "$value": "{color.red.800}" },
      "on-danger": { "$value": "{color.neutral.0}" },
      "danger-text": { "$value": "{color.red.700}", "$description": "Текст ошибок валидации" },
      "info-text": { "$value": "{color.brand.blue}" },
      "status-green-bg": { "$value": "{color.green.100}" },
      "status-green-fg": { "$value": "{color.green.800}" },
      "status-green-solid": { "$value": "{color.green.700}", "$description": "Агрегат на схеме, точка-индикатор" },
      "status-yellow-bg": { "$value": "{color.amber.100}" },
      "status-yellow-fg": { "$value": "{color.amber.800}" },
      "status-yellow-solid": { "$value": "{color.amber.700}" },
      "status-red-bg": { "$value": "{color.red.100}" },
      "status-red-fg": { "$value": "{color.red.800}" },
      "status-red-solid": { "$value": "{color.red.600}" },
      "status-unknown-bg": { "$value": "{color.neutral.100}" },
      "status-unknown-fg": { "$value": "{color.neutral.700}" },
      "status-unknown-solid": { "$value": "{color.neutral.500}" }
    },
    "dark": {
      "canvas": { "$value": "{color.neutral.950}" },
      "surface": { "$value": "{color.neutral.900}" },
      "surface-subtle": { "$value": "{color.neutral.800}" },
      "fg": { "$value": "{color.neutral.100}" },
      "fg-muted": { "$value": "{color.neutral.400}" },
      "fg-disabled": { "$value": "{color.neutral.600}" },
      "border": { "$value": "{color.neutral.700}" },
      "border-strong": { "$value": "{color.neutral.500}" },
      "primary": { "$value": "{color.brand.yellow}" },
      "primary-hover": { "$value": "{color.brand.yellow-light}" },
      "on-primary": { "$value": "{color.brand.ink}" },
      "primary-text": { "$value": "{color.brand.yellow}" },
      "focus-ring": { "$value": "{color.brand.yellow}" },
      "danger": { "$value": "{color.red.400}" },
      "danger-hover": { "$value": "{color.red.300}" },
      "on-danger": { "$value": "{color.brand.ink}" },
      "danger-text": { "$value": "{color.red.400}" },
      "info-text": { "$value": "{color.blue.400}" },
      "status-green-bg": { "$value": "{color.green.950}" },
      "status-green-fg": { "$value": "{color.green.300}" },
      "status-green-solid": { "$value": "{color.green.500}" },
      "status-yellow-bg": { "$value": "{color.amber.950}" },
      "status-yellow-fg": { "$value": "{color.amber.300}" },
      "status-yellow-solid": { "$value": "{color.amber.500}" },
      "status-red-bg": { "$value": "{color.red.950}" },
      "status-red-fg": { "$value": "{color.red.300}" },
      "status-red-solid": { "$value": "{color.red.500}" },
      "status-unknown-bg": { "$value": "{color.neutral.800}" },
      "status-unknown-fg": { "$value": "{color.neutral.300}" },
      "status-unknown-solid": { "$value": "{color.neutral.400}" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter Variable", "Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Inter — шрифт сайта ETS AUTO, есть кириллица (OFL). Sora с сайта не используется: в нём нет кириллицы."
      },
      "mono": {
        "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"],
        "$description": "VIN, коды ошибок, номера тикетов"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },

  "typography": {
    "$type": "typography",
    "mobile": {
      "$description": "Клиентское приложение (Flutter), логические пиксели. Основной текст — не меньше 16.",
      "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "28px", "lineHeight": "34px", "fontWeight": "{font.weight.bold}", "letterSpacing": "-0.02em" } },
      "h1": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "24px", "lineHeight": "30px", "fontWeight": "{font.weight.bold}", "letterSpacing": "-0.01em" } },
      "h2": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "lineHeight": "28px", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0em" } },
      "h3": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "lineHeight": "24px", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0em" } },
      "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": "{font.weight.regular}", "letterSpacing": "0em" } },
      "body-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": "{font.weight.regular}", "letterSpacing": "0em" } },
      "label": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "20px", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0em" } },
      "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": "{font.weight.medium}", "letterSpacing": "0.01em" } }
    },
    "web": {
      "$description": "Кабинет инженера и админ-панель, десктоп Full HD. Плотнее мобильной шкалы.",
      "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "32px", "lineHeight": "40px", "fontWeight": "{font.weight.bold}", "letterSpacing": "-0.02em" } },
      "h1": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "26px", "lineHeight": "34px", "fontWeight": "{font.weight.bold}", "letterSpacing": "-0.01em" } },
      "h2": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "lineHeight": "28px", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0em" } },
      "h3": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0em" } },
      "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "lineHeight": "22px", "fontWeight": "{font.weight.regular}", "letterSpacing": "0em" } },
      "body-sm": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": "{font.weight.regular}", "letterSpacing": "0em" } },
      "label": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0em" } },
      "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": "{font.weight.medium}", "letterSpacing": "0.01em" } }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "Шкала отступов, сетка 4 px. Других значений в интерфейсе нет (чек-лист консистентности).",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "sm — бейджи-теги, чекбоксы; md — кнопки, поля; lg — карточки; xl — боттом-шит, модальные окна; full — бейджи статусов, аватары.",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "20px" },
    "full": { "$value": "9999px" }
  },

  "size": {
    "$type": "dimension",
    "tap-target-min": { "$value": "44px", "$description": "Минимальная зона касания (ТЗ раздел 6, Apple HIG). Мобильные контролы и агрегаты на схеме." },
    "control-mobile": { "$value": "48px", "$description": "Высота кнопок и полей в мобильном приложении" },
    "control-web": { "$value": "40px", "$description": "Высота кнопок и полей в вебе (мышь; WCAG 2.5.8 — от 24 px)" },
    "control-web-sm": { "$value": "32px", "$description": "Компактные кнопки в таблицах и канбане" },
    "bottom-nav": { "$value": "64px", "$description": "Высота нижней навигации без safe area" },
    "icon-sm": { "$value": "16px" },
    "icon-md": { "$value": "20px" },
    "icon-lg": { "$value": "24px" }
  },

  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#0000000f" } },
    "md": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px", "color": "#0000001a" } },
    "lg": { "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px", "color": "#00000029" } }
  },

  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "normal": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  }
}
